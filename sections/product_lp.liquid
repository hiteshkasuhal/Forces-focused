{% if section.settings.product != blank %}
  {% assign product = section.settings.product %}
{%- style -%}
{% if section.settings.bg != blank %}
    .section_bg_{{ section.id }} {
      background-image:url({{section.settings.bg | image_url}});
    background-size: cover;
    background-attachment: unset;
    background-repeat: no-repeat;
    background-position: bottom;
    }
  {% endif %}
{% if section.settings.bg_mobile != blank %}
  @media screen and (max-width: 915px) {
    .section_bg_{{ section.id }} {
      background-image:url({{section.settings.bg_mobile | image_url}});
    }
  }
  {% endif %}
  @media screen and (max-width: 915px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
  @media screen and (min-width: 915px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="landing_page_product  section_bg_{{ section.id }} {{ section.settings.custom_class }}"{% if section.settings.custom_id != blank %} id="{{ section.settings.custom_id }}"{% endif %}
style="background-color:{{ section.settings.bg_color | default:'transparent' }};color:{{ section.settings.color }};">
   <div class="container_hk section-{{ section.id }}-padding isolate">
     {% if section.settings.heading != blank %}
       <div class="center product_top_custom_new mobile_only">
       <h2 class="rich-text__heading  inline-richtext product_title_heading h1">{{ section.settings.heading }}</h2>
         {% if section.settings.text != blank %}
           <div class="rich-text__text  product_text">{{ section.settings.text }}</div>
         {% endif %}
 <div class="rich-text__text product_rating_lp">
<div class="reviews_rating_html">
<a href="#reviews">
{% if section.settings.image != blank %}
<img src="{{ section.settings.image | image_url }}" alt="{{ section.settings.image.alt }}" width="auto" height="auto" loading="eager" fetchpriority="high">
{% endif %}
<span>{{ section.settings.text2 }}</span>
</a>
</div>
 </div>
       </div>
       {% endif %}
