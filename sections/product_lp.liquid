  {% if block.settings.image != blank %}
<img src="{{  block.settings.image | image_url }}" width="auto" height="auto" loading="eager" fetchpriority="high" alt="{{ product_related.title }}">
    {% else %}
<img src="{{ product_related.featured_image | image_url }}" width="auto" height="auto" loading="eager" fetchpriority="high" alt="{{ product_related.title }}">
    {% endif %}

<div class="related_products_slider_flex_right_top">
{% if block.settings.subheading != blank %}
<div class="related_products_lp_subheading">{{ block.settings.subheading }}</div>
{% endif %}
<div class="related_products_slider_title_top">{{ block.settings.title_main | default:product_related.title }}</div>
