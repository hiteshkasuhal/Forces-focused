<script>
    $('.slider_{{ section.id }}').slick({
  dots: false,
  speed: 300,
  slidesToShow: 1,
  slidesToScroll: 1,
  autoplay: false,
  infinite: true,
  cssEase:'linear',
  asNavFor: '.slider_thumb_{{ section.id }}',
    prevArrow: $('.prev_{{ section.id }}_main_slider'),
    nextArrow: $('.next_{{ section.id }}_main_slider'),
      responsive: [
    {
      breakpoint: 915,
      settings: {
        slidesToShow:1, 
        slidesToScroll: 1, 
      }
    }
  ]
 
});

    $('.slider_thumb_{{ section.id }}').slick({
  dots: false,
  speed: 300,
  slidesToShow: 7,
  slidesToScroll: 1,
  autoplay: false,
  infinite: true,
  cssEase:'linear',
    asNavFor: '.slider_{{ section.id }}',
    focusOnSelect: true,
    prevArrow: $('.prev_{{ section.id }}'),
    nextArrow: $('.next_{{ section.id }}'),
});
$(document).on("click", '.trigger_{{ section.id }}', function (e) {
  e.preventDefault();

  var $btn = $(this).addClass('loading_hk');
  var items = [];

var unactive = $('.subscription_item.unactive').length;
if (unactive == 0){
  // Main item
  var mainVariantId = $btn.attr('variant_id');
  var sellingPlan = $btn.attr('selling_plan');

  var mainItem = {
    id: parseInt(mainVariantId),
    quantity: 1
  };

  if (sellingPlan) {
    mainItem.selling_plan = parseInt(sellingPlan);
  }

  items.push(mainItem);
}

  // Related products
 /* $('.related_products_slider_flex_item.active .variant_selector.active').each(function () {
    var relatedId = $(this).attr('variant_id');
    if (relatedId) {
      items.push({
        id: parseInt(relatedId),
        quantity: 1
      });
    }
  });*/

  // Single call to /cart/add.js
  $.ajax({
    type: 'POST',
    url: '/cart/add.js',
    data: JSON.stringify({ items: items }),
    dataType: 'json',
    contentType: 'application/json',
    success: function () {
      location.href = "/checkout";
    },
    complete: function () {
      setTimeout(function () {
        $btn.removeClass('loading_hk');
      }, 500);
    }
  });
});

$(document).on("click", '.option_item', function(e) { 
$(this).parents('.custom_variants_landing_page').find('.option_item').removeClass('active');  
$(this).addClass('active');  
var selected_variant = $(this).attr('variant_id');
$('span.custom_checkout_button').attr('variant_id',selected_variant); 
$('.price_trigger').hide().removeClass('active');
$('.price_trigger[data_tab="'+selected_variant+'"]').show().addClass('active');
});
  
$(document).on("click", '.subscription_item', function(e) {
$(this).parents('.custom_variants_landing_page').find('.subscription_item').removeClass('active');  
$(this).addClass('active');  
var selected_tab = $(this).attr('data_tab');
if (selected_tab == '2'){
var selling_plan = $(this).attr('selling_plan');
$('.trigger_{{ section.id }}').attr('selling_plan',selling_plan);
$('.options_flex .option_item:first-child').trigger('click');
} else {
$('.trigger_{{ section.id }}').removeAttr('selling_plan');
}
$(this).parents('.landing_product_flex').find('.subscription_trigger').hide();
$(this).parents('.landing_product_flex').find('.subscription_trigger[data_tab="'+selected_tab+'"]').show();
});
  
$(document).on("click", '.sub_flex_bottom_delivery_item', function(e) {
$(this).parents('.custom_variants_landing_page').find('.sub_flex_bottom_delivery_item').removeClass('active');  
$(this).addClass('active');  
var selected_text = $(this).text();
var selling_plan = $(this).attr('selling_plan');
$('.landing_page_product .sub_flex_bottom_delivery_label span').text(selected_text);
$('.trigger_{{ section.id }}').attr('selling_plan',selling_plan);
$('.subscription_item_sub').attr('selling_plan',selling_plan);
});

$(document).on("click", '.related_products_slider_cart', function(e) {
$(this).toggleClass('active');  
});


$(document).on("click", '.related_products_slider_flex_item:not(.active)', function(e) { 
$('.related_products_slider_flex_item').removeClass('active');  
$(this).addClass('active');  
});
$(document).on("click", '.variant_selector', function(e) { 
$(this).parents('.related_products_variants').find('.variant_selector').removeClass('active');  
$(this).addClass('active');  
});


$(document).on("click", ".related_products_slider_flex_item.active", function (e) {
    // Check if click is NOT inside .related_products_variants
    if ($(e.target).closest(".related_products_variants").length === 0) {
        $(this).removeClass("active");
    }
    var upsells_active = $('.related_products_slider_flex_item.active').length;
 if(upsells_active == 0){
        $('.subscription_item').removeClass("unactive");
}
});



