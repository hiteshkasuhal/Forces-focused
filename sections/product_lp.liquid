  <div class="related_products_slider_price">
{% for variant in product_related.variants %}
  <div class="related_products_variant_price" data_tab="{{  variant.id }}"{% if variant.id != product_related.selected_or_first_available_variant.id %} style="display:none;"{%endif %}>{{ variant.price | money }}</div>
{% endfor %}
  </div>
<div class="related_products_slider_flex_right">
<div class="related_products_slider_flex_right-top">
             <div class="price_flex_inner">
  {% assign price = product_related.selected_or_first_available_variant.price %}
  {% if product_related.selected_or_first_available_variant.selling_plan_allocations.first.selling_plan.id != blank %}
  {% assign price = product_related.selected_or_first_available_variant.selling_plan_allocations.first.per_delivery_price %}
    {% endif %}
  {% assign compare_price = product_related.selected_or_first_available_variant.price %}
  {% if product_related.selected_or_first_available_variant.compare_at_price > product_related.selected_or_first_available_variant.price %}
  {% assign compare_price = product_related.selected_or_first_available_variant.compare_at_price %}
    {% endif %}
                  <span class="price_single">{{ price | money }}</span>
                  {% if compare_price > price %} <span class="price_compare">{{ compare_price | money }}</span>
                  <span class="discounted_percentage">
                 SAVE {{ compare_price | minus:price | times:100 | divided_by:compare_price  }}%
                  </span>
                    {% endif %}
                </div>
  </div>
<div class="related_products_slider_cart{% if block.settings.custom_class contains 'preselected' %}  active"{%endif%}{% if product_related.available %}{% else %} disabled{% endif %} variant_id="{{ product_related.selected_or_first_available_variant.id }}">
  <span class="added"><svg xmlns="http://www.w3.org/2000/svg" width="23" height="24" viewBox="0 0 23 24" fill="none">
  <circle cx="12.4" cy="13.4" r="8.4" stroke="#22D488" stroke-width="1.86667"/>
  <path d="M8.66663 13.3996L11.4666 16.1996L16.1333 10.5996" stroke="#22D488" stroke-width="1.86667"/>
</svg>{% if product_related.available %}Added to cart{% else %}Sold Out{% endif %}</span>
  <span class="add" style="display:none;">{% if product_related.available %}Add to cart{% else %}Sold Out{% endif %}</span>
  </div>
</div>
</div>
</div>


