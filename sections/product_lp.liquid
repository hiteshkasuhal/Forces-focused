  function updateUpsell() {
    const $items  = $('.related_products_slider_flex_item');
    const $active = $items.filter('.active').first();

    // 1-based index for tabs, or 0 when no active
    const tab = $active.length ? ($items.index($active) + 1) : 0;
var unactive = $('.subscription_item.unactive').length;
if (unactive > 0){
    $('.upsell_add').hide();
    $('.upsell_add_alone').hide().filter(`[data_tab="${tab}"]`).show();

} else {
    $('.upsell_add_alone').hide();
    $('.upsell_add')
      .hide()
      .filter(`[data_tab="${tab}"]`)
      .show();
}
  }



$(document).on('click', '.related_products_slider_flex_item', function () {
    updateUpsell();
  });
</script>
