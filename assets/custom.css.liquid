ul.slick-dots {
    display: flex;
    list-style-type: none;
    padding: 0px;
    gap: 12px;
}
.slider_navigations.center {
    display: flex;
    align-items: center;
    gap: 46px;
    padding-top: 60px;
}
ul.slick-dots li {
    width: 13.769px;
    height: 13.769px;
    position: relative;
    cursor: pointer;
    transition: all 0.5s;
}
ul.slick-dots li:after {
    content: "";
    position: absolute;
    width: 100%;
    height: 100%;
    background: #DFDFDF;
    border-radius: 30px;
    left: 0px;
    top: 0;
}
ul.slick-dots li button {
    width: 100%;
    height: 100%;
    font-size: 0px;
    padding: 0px;
    opacity: 0;
}
ul.slick-dots li.slick-active:after {
    background: #202A45;
}
ul.slick-dots li.slick-active {
    width: 38.779px;
}
.slider_button_custom svg {
    display: block;
}
.slider_navigations .slider_button_custom:nth-child(1) {
    transform: rotate(180deg);
}
.slider_button_custom {
    cursor: pointer;
}
